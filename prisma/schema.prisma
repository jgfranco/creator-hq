// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  emailVerified Boolean  @default(false)
  image         String?

  memberships Membership[]
  sessions    Session[]
  accounts    Account[]
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  currency  String   @default("USD") @db.Char(3)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Next number handed out when an invoice is sent (INV-0001, INV-0002, …)
  nextInvoiceNumber Int @default(1)

  memberships Membership[]
  brands      Brand[]
  campaigns   Campaign[]
  invoices    Invoice[]
}

enum Role {
  OWNER
  MANAGER
  VIEWER
}

model Membership {
  id        String   @id @default(cuid())
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Brand {
  id         String    @id @default(cuid())
  name       String    @db.Citext // case-insensitive, so "Nike" and "nike" collide
  website    String?
  notes      String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  contacts  Contact[]
  campaigns Campaign[]

  @@unique([workspaceId, name])
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String?
  title     String?
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([brandId])
}

enum CampaignStatus {
  LEAD
  NEGOTIATING
  CONTRACTED
  IN_PRODUCTION
  POSTED
  INVOICED
  PAID
  CANCELLED
}

model Campaign {
  id        String         @id @default(cuid())
  title     String
  status    CampaignStatus @default(LEAD)
  feeCents  Int?
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id], onDelete: Restrict)

  deliverables Deliverable[]
  invoices     Invoice[]

  @@index([workspaceId, status])
  @@index([brandId])
}

enum DeliverableType {
  POST
  REEL
  STORY
  SHORT
  VIDEO
  INTEGRATION
  LIVESTREAM
  AD_READ
  ARTICLE
  OTHER
}

enum Platform {
  INSTAGRAM
  TIKTOK
  YOUTUBE
  TWITCH
  X
  FACEBOOK
  LINKEDIN
  PINTEREST
  SNAPCHAT
  THREADS
  PODCAST
  NEWSLETTER
  BLOG
  OTHER
}

enum DeliverableStatus {
  NOT_STARTED
  IN_PROGRESS
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  POSTED
  CANCELLED
}

model Deliverable {
  id            String            @id @default(cuid())
  type          DeliverableType
  platform      Platform
  status        DeliverableStatus @default(NOT_STARTED)
  dueDate       DateTime?
  scheduledFor  DateTime?
  postedAt      DateTime?
  liveUrl       String?
  revisionCount Int               @default(0)
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id         String        @id @default(cuid())
  // Assigned when the invoice is sent, so deleted drafts never leave gaps
  number     Int?
  status     InvoiceStatus @default(DRAFT)
  // Copied from the workspace so later currency changes don't alter old invoices
  currency   String        @db.Char(3)
  issueDate  DateTime
  dueDate    DateTime
  notes      String?
  // Sum of line items, kept in sync on every write so lists don't need to aggregate
  totalCents Int           @default(0)
  sentAt     DateTime?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  campaignId String
  // NoAction (checked at end of statement) rather than Restrict, so deleting a whole
  // workspace still cascades cleanly while deleting an invoiced campaign is blocked
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: NoAction)

  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@unique([workspaceId, number])
  @@index([workspaceId, status])
  @@index([campaignId])
}

model InvoiceLineItem {
  id              String @id @default(cuid())
  description     String
  quantity        Int    @default(1)
  unitAmountCents Int
  position        Int

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

enum PaymentMethod {
  BANK_TRANSFER
  PAYPAL
  STRIPE
  WISE
  CHECK
  CASH
  OTHER
}

model Payment {
  id          String        @id @default(cuid())
  amountCents Int
  paidOn      DateTime
  method      PaymentMethod
  reference   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  invoiceId String
  // Cascade so deleting a workspace works; the app only deletes draft invoices,
  // which can't have payments
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}
